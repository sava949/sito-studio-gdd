---
/**
 * «Il primo colloquio», disegnata a mano: come si arriva dal primo contatto
 * all'incarico, in passi numerati, cosa portare e cosa fare se c'è urgenza.
 * Niente compensi né gratuità del colloquio: lo studio ha chiesto di non
 * indicarli (questionario, sezione 5.3). Testi modificabili dall'editor
 * (src/lib/contenuti.ts); i numeri di telefono sono i «Dati dello studio».
 */
export const prerender = false;

import Base from "../layouts/Base.astro";
import ContenutoEditor from "../components/ContenutoEditor.astro";
import { contenutoDi, studioDi, marcatori } from "../lib/contenuti";
import { testi } from "../lib/lingua";

const PREDEFINITO = testi(Astro).colloquio;

const { c, componi } = await contenutoDi(Astro, "/primo-colloquio", PREDEFINITO);
const studio = await studioDi(Astro);
const { t, r, l, v } = marcatori(componi);
---

<Base titolo="Il primo colloquio" descrizione="Come funziona il primo colloquio con lo Studio Legale G.D.D.: dal primo contatto all'incarico, cosa portare e cosa fare in caso di urgenza." componi={componi}>
  <div class="pag">
    <header class="pag-apertura">
      <p class="pag-occhio" data-anima="sali" {...t("occhio")}>{c.occhio}</p>
      <h1 data-anima="sali" {...r("titolo")} set:html={c.titolo} />
      <p class="pag-lead" data-anima="sali" {...t("lead")}>{c.lead}</p>
    </header>

    <!-- ── i passi ── -->
    <ol class="passi" {...l("passi")}>
      {c.passi.map((p, i) => (
        <li class="passo" {...v(i)}>
          <span class="passo__num">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h2 {...t(`passi.${i}.titolo`)}>{p.titolo}</h2>
            <p {...t(`passi.${i}.testo`)}>{p.testo}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- ── cosa portare ── -->
    <section class="pag-sezione portare">
      <div>
        <p class="pag-occhio" {...t("portare.occhio")}>{c.portare.occhio}</p>
        <h2 {...t("portare.titolo")}>{c.portare.titolo}</h2>
        <p class="portare__nota" {...t("portare.nota")}>{c.portare.nota}</p>
      </div>
      <ul class="portare__lista" {...l("portare.voci")}>
        {c.portare.voci.map((x, k) => <li {...v(k)} {...t(`portare.voci.${k}`)}>{x}</li>)}
      </ul>
    </section>

    <!-- ── riservatezza e urgenze ── -->
    <section class="pag-sezione pag-due">
      <div>
        <p class="pag-etichetta" {...t("riservatezza.etichetta")}>{c.riservatezza.etichetta}</p>
        <p {...t("riservatezza.testo")}>{c.riservatezza.testo}</p>
      </div>
      <div>
        <p class="pag-etichetta" {...t("urgenza.etichetta")}>{c.urgenza.etichetta}</p>
        <p {...t("urgenza.testo")}>{c.urgenza.testo}</p>
        <p class="urgenza__numeri">
          <a href={studio.telefonoLink}>{studio.telefono}</a>
          <a href={studio.cellulareLink}>{studio.cellulare}</a>
        </p>
      </div>
    </section>

    <p class="avvertenza" {...r("avvertenza")} set:html={c.avvertenza} />
  </div>
  <ContenutoEditor c={c} componi={componi} />
</Base>

<style>
  /* I passi: una linea verticale rossa che li unisce, numeri grandi a sinistra. */
  .passi { list-style: none; margin: 0 0 clamp(4rem, 9vw, 7rem); padding: 0; border-top: 1px solid var(--linea); }
  .passo {
    display: grid; grid-template-columns: clamp(5rem, 12vw, 9rem) 1fr; gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(2rem, 4.5vw, 3.2rem) 0; border-bottom: 1px solid var(--linea); position: relative;
  }
  .passo__num { font-family: var(--serif); font-size: clamp(3rem, 7vw, 5.5rem); line-height: .9; color: transparent; -webkit-text-stroke: 1px var(--accento-viva); }
  .passo h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin: .2rem 0 .9rem; }
  .passo p { margin: 0; max-width: 44rem; color: var(--inchiostro-2); font-size: 1.06rem; line-height: 1.8; }

  .portare { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .portare h2 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1.2rem; }
  .portare__nota { color: var(--tenue); margin: 0; }
  .portare__lista { list-style: none; margin: 0; padding: 0; counter-reset: voce; }
  .portare__lista li {
    counter-increment: voce; position: relative; padding: 1.1rem 0 1.1rem 3.2rem;
    border-top: 1px solid var(--linea); color: var(--inchiostro-2); font-size: 1.02rem;
  }
  .portare__lista li:last-child { border-bottom: 1px solid var(--linea); }
  .portare__lista li::before {
    content: counter(voce, lower-roman) "."; position: absolute; left: 0; top: 1.1rem;
    font-family: var(--serif); font-style: italic; color: var(--accento-viva); font-size: 1.1rem;
  }
  .pag-due a { color: #fff; text-decoration: none; border-bottom: 1px solid var(--accento); white-space: nowrap; }
  .pag-due a:hover { color: var(--accento-viva); }
  /* I numeri, in mezzo al testo e ben leggibili, uno per riga. */
  .urgenza__numeri { display: flex; flex-direction: column; gap: .4rem; margin: 1.2rem 0; }
  .urgenza__numeri a { font-family: var(--serif); font-size: 1.6rem; border-bottom: 0; align-self: flex-start; }

  .avvertenza {
    margin: 0 auto clamp(3rem, 7vw, 5rem); max-width: 76rem; padding-top: 1.4rem;
    border-top: 1px solid var(--linea);
    font-family: var(--serif); font-style: italic; color: var(--tenue); font-size: .98rem; line-height: 1.7;
  }
  .avvertenza a { color: var(--inchiostro); }

  /* Telefono: numeri piccoli accanto al titolo, passi più stretti. */
  @media (max-width: 760px) {
    .passi { margin-bottom: 2.8rem; }
    .passo { grid-template-columns: 2.8rem 1fr !important; gap: 1rem; padding: 1.6rem 0; }
    .passo__num { font-size: 2.2rem; }
    .passo h2 { font-size: 1.35rem; margin: 0 0 .5rem; }
    .passo p { font-size: .98rem; line-height: 1.7; }
    .portare h2 { font-size: 1.8rem; }
    .portare__lista li { padding: .8rem 0 .8rem 2.4rem; font-size: .95rem; }
    .portare__lista li::before { top: .8rem; }
    .urgenza__numeri a { font-size: 1.4rem; }
  }
  @media (max-width: 820px) {
    .portare { grid-template-columns: 1fr; }
    .passo { grid-template-columns: 4rem 1fr; }
  }
</style>
