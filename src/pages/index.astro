---
/**
 * L'ANTICAMERA: la home dello Studio Legale G.D.D.
 *
 * Non è una pagina a foglio libero come le altre: è la soglia del sito, fatta
 * a mano. Fondo antracite, il rosso del portone sui dettagli, un grande
 * «Accedi allo studio» e, scorrendo, le informazioni essenziali che salgono
 * una alla volta. Il portone (foto vera, anta 3D) si apre e ci si entra.
 *
 * Testi e foto si modificano dall'editor (src/lib/contenuti.ts); le aree e
 * i nomi delle persone vengono dalle loro pagine, i recapiti dai «Dati dello
 * studio». In composizione l'ingresso animato è spento.
 */
export const prerender = false;

import { leggiSito } from "../lib/store";
import { contenutoDi, studioDi, elencoAree, marcatori, ancoraPersona } from "../lib/contenuti";
import { testi, traduttore, inglese, paginaInglese } from "../lib/lingua";
import ContenutoEditor from "../components/ContenutoEditor.astro";
import Portone from "../components/Portone.astro";

const { home: PREDEFINITO, professionisti: PROFESSIONISTI, area: areaPredefinita } = testi(Astro);
const en = inglese(Astro);
const L = traduttore(Astro);
const { c, componi } = await contenutoDi(Astro, "/", PREDEFINITO);
const studio = await studioDi(Astro);
const { t, f, l, v } = marcatori(componi);

/* Dopo la porta si entra nello studio. */
const INGRESSO = "/studio";

const aree = await elencoAree(Astro, areaPredefinita);
/* In home solo i nomi, sulla foto di gruppo: i ritratti stanno in «I professionisti». */
const persone = (await contenutoDi(Astro, "/professionisti", PROFESSIONISTI)).c.elenco;

const nome = String((await leggiSito("impostazioni")).nome ?? studio.nome);
const lettere = String(c.sigla ?? "").split(".").filter(Boolean);
const ROMANI = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"];
const anno = new Date().getFullYear();
/* Gli indirizzi assoluti della home nelle due lingue (canonico e hreflang). */
const assoluto = (p: string) => (Astro.site ? new URL(p, Astro.site).href : undefined);
const comeArrivare = [studio.metro && `Metro ${studio.metro}`, studio.treno, studio.autobus].filter(Boolean).join(" · ");

/* I dati strutturati (schema.org) per i motori di ricerca: chi è lo studio,
   dove sta, come si contatta. Tutto dai «Dati dello studio»; gli orari si
   ricavano dalla scritta, e se non si riconoscono si tacciono. */
const fasce = [...String(studio.orari ?? "").matchAll(/(\d{1,2})[:.](\d{2})\s*[–-]\s*(\d{1,2})[:.](\d{2})/g)];
const feriali = /luned.*venerd|monday.*friday/i.test(String(studio.orari ?? ""));
const ora = (h: string, m: string) => `${h.padStart(2, "0")}:${m}`;
const datiStrutturati = assoluto("/") && {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "@id": `${assoluto("/")}#studio`,
  name: nome,
  legalName: studio.denominazione,
  url: assoluto(en ? "/en" : "/"),
  image: assoluto("/foto/portone.webp"),
  telephone: studio.telefonoLink.replace("tel:", ""),
  email: studio.email || undefined,
  vatID: studio.partitaIva || undefined,
  address: {
    "@type": "PostalAddress",
    streetAddress: studio.via,
    postalCode: studio.cap,
    addressLocality: studio.citta,
    addressRegion: studio.provincia,
    addressCountry: "IT",
  },
  areaServed: { "@type": "City", name: L("Roma", "Rome") },
  openingHoursSpecification: feriali && fasce.length
    ? fasce.map((x) => ({
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        opens: ora(x[1], x[2]),
        closes: ora(x[3], x[4]),
      }))
    : undefined,
  knowsAbout: aree.map((a) => a.titolo),
  employee: persone.map((p) => ({ "@type": "Person", name: p.nome, jobTitle: p.ruolo })),
};
---

<!doctype html>
<html lang={en ? "en" : "it"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{nome} — {L("Avvocati a Roma", "Lawyers in Rome")}</title>
    <meta name="description" content={en ? paginaInglese("/")?.seo?.descrizione : `${nome}, studio legale a Roma (Balduina): diritto penale e processuale penale, penale d'impresa e tributario, diritto civile e societario, famiglia e minori.`} />
    {assoluto("/") && <link rel="canonical" href={assoluto(en ? "/en" : "/")} />}
    {assoluto("/") && <link rel="alternate" hreflang="it" href={assoluto("/")} />}
    {assoluto("/") && <link rel="alternate" hreflang="en" href={assoluto("/en")} />}
    {assoluto("/") && <link rel="alternate" hreflang="x-default" href={assoluto("/")} />}
    {datiStrutturati && !componi && <script is:inline type="application/ld+json" set:html={JSON.stringify(datiStrutturati).replace(/</g, "\\u003c")} />}
    <meta property="og:title" content={nome} />
    <meta property="og:image" content="/foto/portone.webp" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* La porta è la prima cosa che si vede: le sue foto partono subito. */}
    <link rel="preload" as="image" href="/porta/anta.webp" type="image/webp" fetchpriority="high" />
    <link rel="preload" as="image" href="/porta/sinistra.webp" type="image/webp" />
    <link rel="preload" as="image" href="/porta/destra.webp" type="image/webp" />
    {/* Oltre la porta c'è «Lo studio»: il browser la prepara mentre si guarda
        l'anticamera, così alla fine dell'ingresso è già pronta (Chrome ed Edge
        la preparano per intero, gli altri ne scaricano almeno il documento). */}
    {!componi && <link rel="prefetch" href={(en ? "/en" : "") + INGRESSO} as="document" />}
    {!componi && <script is:inline type="speculationrules" set:html={JSON.stringify({ prerender: [{ urls: [(en ? "/en" : "") + INGRESSO] }] })} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" />
  </head>

  <body>
    <!-- ───────────────────────── la soglia ───────────────────────── -->
    <header class="soglia">
      <nav class="lingue lingue--soglia" aria-label={L("Lingua", "Language")}>
        <a href="/" hreflang="it" lang="it" aria-current={en ? undefined : "true"}>IT</a>
        <a href="/en" hreflang="en" lang="en" aria-current={en ? "true" : undefined}>EN</a>
      </nav>
      <div class="soglia__testo">
        <p class="occhiello"><span class="filo"></span><span {...t("occhiello")}>{c.occhiello}</span></p>
        <h1 class="marchio">
          <span class="marchio__studio" {...t("studioLegale")}>{c.studioLegale}</span>
          <span class="marchio__sigla" {...t("sigla")}>{lettere.map((x) => <>{x}<i>.</i></>)}</span>
        </h1>
        <p class="soglia__frase" {...t("frase")}>{c.frase}</p>
        <a class="accedi" href={INGRESSO} data-entra>
          <span {...t("accedi")}>{c.accedi}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </a>
        <p class="soglia__indirizzo" {...t("indirizzo")}>{c.indirizzo}</p>
      </div>

      <a class="soglia__porta" href={INGRESSO} data-entra aria-label={`${c.accedi}: ${L("il portone di", "the front door at")} ${studio.via}`}>
        <div class="cornice">
          <Portone />
        </div>
      </a>
    </header>

    <main>
      <!-- ───────────────────────── la dedica ───────────────────────── -->
      <section id="dedica" class="dedica">
        <p class="etichetta sale" {...t("dedica.etichetta")}>{c.dedica.etichetta}</p>
        <p class="dedica__nome sale" {...t("dedica.nome")}>{c.dedica.nome}</p>
        <p class="dedica__nota sale" {...t("dedica.nota")}>{c.dedica.nota}</p>
        <p class="sale"><a class="dedica__link" href="/tommaso-novelli" {...t("dedica.link")}>{c.dedica.link}</a></p>
      </section>

      <!-- ───────────────────────── i tratti ───────────────────────── -->
      <section class="tratti" {...l("tratti")}>
        {c.tratti.map((x, i) => (
          <div class="tratto sale" {...v(i)}>
            <span class="tratto__num">{ROMANI[i] ?? i + 1}</span>
            <h3 {...t(`tratti.${i}.titolo`)}>{x.titolo}</h3>
            <p {...t(`tratti.${i}.testo`)}>{x.testo}</p>
          </div>
        ))}
      </section>

      <!-- ───────────────────────── le aree ───────────────────────── -->
      <section class="aree">
        <div class="intesta sale">
          <p class="etichetta" {...t("aree.etichetta")}>{c.aree.etichetta}</p>
          <h2 {...t("aree.titolo")}>{c.aree.titolo}</h2>
        </div>
        <ol class="aree__elenco">
          {aree.map((a, i) => (
            <li class="sale" style={`--ritardo:${i * 90}ms`}>
              <a href={a.href}>
                <span class="aree__num">{String(i + 1).padStart(2, "0")}</span>
                <span class="aree__corpo">
                  <span class="aree__titolo">{a.titolo}</span>
                  <span class="aree__sintesi">{a.sintesi}</span>
                </span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <!-- ───────────────────────── le persone ───────────────────────── -->
      <section class="persone">
        <div class="intesta sale">
          <p class="etichetta" {...t("persone.etichetta")}>{c.persone.etichetta}</p>
          <h2 {...t("persone.titolo")}>{c.persone.titolo}</h2>
        </div>
        <div class="persone__insieme">
          <figure class="persone__foto sale"><img src={c.persone.foto} alt={L("Le persone dello studio", "The people of the firm")} loading="lazy" {...f("persone.foto")} /></figure>
          <ul class="persone__nomi">
            {persone.map((p, i) => (
              <li class="sale" style={`--ritardo:${i * 120}ms`}>
                <a href={`/professionisti#${ancoraPersona(p.nome)}`}><span class="persona__nome">{p.nome}</span><span class="persona__ruolo">{p.ruolo}</span></a>
              </li>
            ))}
            <li class="sale" style={`--ritardo:${persone.length * 120}ms`}><a class="persone__tutti" href="/professionisti" {...t("persone.tutti")}>{c.persone.tutti}</a></li>
          </ul>
        </div>
      </section>

      <!-- ───────────────────────── il luogo ───────────────────────── -->
      <section class="luogo">
        <div class="luogo__foto sale"><img src={c.luogo.foto} alt={L("L'ingresso dello studio", "The entrance to the firm")} loading="lazy" {...f("luogo.foto")} /></div>
        <div class="luogo__testo sale">
          <p class="etichetta" {...t("luogo.etichetta")}>{c.luogo.etichetta}</p>
          <h2><span {...t("luogo.riga1")}>{c.luogo.riga1}</span><br /><span {...t("luogo.riga2")}>{c.luogo.riga2}</span></h2>
          <dl>
            <div><dt>{L("Telefono", "Telephone")}</dt><dd><a href={studio.telefonoLink}>{studio.telefono}</a></dd></div>
            <div><dt>{L("Cellulare", "Mobile")}</dt><dd><a href={studio.cellulareLink}>{studio.cellulare}</a></dd></div>
            {studio.email && <div><dt>Email</dt><dd><a href={`mailto:${studio.email}`}>{studio.email}</a></dd></div>}
            <div><dt>PEC</dt><dd><a href={`mailto:${studio.pec}`}>{studio.pec}</a></dd></div>
            <div><dt>{L("Orari", "Hours")}</dt><dd>{studio.orari}, {L("su appuntamento", "by appointment")}</dd></div>
            {comeArrivare && <div><dt>{L("Come arrivare", "Getting here")}</dt><dd>{comeArrivare}</dd></div>}
          </dl>
        </div>
      </section>

      <!-- ───────────────────────── di nuovo la porta ───────────────────────── -->
      <section class="ancora">
        <h2 class="sale" {...t("chiusura.titolo")}>{c.chiusura.titolo}</h2>
        <a class="accedi accedi--grande sale" href={INGRESSO} data-entra>
          <span {...t("chiusura.accedi")}>{c.chiusura.accedi}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </a>
      </section>
    </main>

    <footer class="piede">
      <p>{studio.denominazione} · {studio.via}, {studio.cap} {studio.citta} · {L("P. IVA", "VAT no.")} {studio.partitaIva}</p>
      <p><a href="/note-legali">{L("Note legali", "Legal notice")}</a> · <a href="/privacy">Privacy</a> · © {anno}</p>
    </footer>
    <ContenutoEditor c={c} componi={componi} />

    <!-- Il segnale che la pagina continua: sparisce appena si scorre. -->
    <a class="continua" href="#dedica" aria-label={L("Scorri: la pagina continua", "Scroll: the page continues")}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    </a>

    <!-- L'uscita: lo zoom dentro la porta, poi la pagina interna. -->
    <div class="varco" aria-hidden="true"></div>
    <div class="velo" aria-hidden="true"></div>

    {!componi && (
    <script is:inline>
      document.documentElement.classList.add("js");
      (function () {
        var io = new IntersectionObserver(function (voci) {
          voci.forEach(function (v) {
            if (v.isIntersecting) { v.target.classList.add("visibile"); io.unobserve(v.target); }
          });
        }, { threshold: 0.15, rootMargin: "0px 0px -6% 0px" });
        document.querySelectorAll(".sale").forEach(function (n) { io.observe(n); });

        /* Il segnale «continua» se ne va al primo scorrimento. */
        var segnale = function () { document.body.classList.toggle("scorsa", scrollY > 40); };
        addEventListener("scroll", segnale, { passive: true }); segnale();

        var calmo = matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.querySelectorAll("[data-entra]").forEach(function (a) {
          a.addEventListener("click", function (e) {
            if (calmo || e.metaKey || e.ctrlKey) return;
            e.preventDefault();
            if (document.body.classList.contains("entra")) return;
            /* Da più in basso non si risale scorrendo (la porta si muoverebbe
               mentre la si misura): lo schermo si vela, si torna in cima di
               colpo, il velo si alza sulla porta e ci si entra. */
            var lontano = scrollY > 40;
            var attesa = lontano ? 750 : 0;
            if (lontano) {
              document.body.classList.add("velato");
              setTimeout(function () {
                document.documentElement.style.scrollBehavior = "auto";
                window.scrollTo({ top: 0, left: 0, behavior: "instant" });
                requestAnimationFrame(function () { requestAnimationFrame(function () { document.body.classList.remove("velato"); }); });
              }, 380);
            }
            setTimeout(function () {
              /* Il viaggio: la porta scivola al centro dello schermo mentre
                 l'anta si apre, poi ci si entra. Il punto fisso dello zoom è
                 il centro del vano, e lo spostamento lo porta al centro. */
              var porta = document.querySelector(".soglia__porta");
              var vano = document.querySelector(".portone__luce").getBoundingClientRect();
              var box = porta.getBoundingClientRect();
              var cx = vano.left + vano.width / 2, cy = vano.top + vano.height / 2;
              porta.style.transformOrigin = (cx - box.left) + "px " + (cy - box.top) + "px";
              porta.style.setProperty("--dx", (innerWidth / 2 - cx) + "px");
              porta.style.setProperty("--dy", (innerHeight / 2 - cy) + "px");
              document.body.classList.add("entra");
            }, attesa);
            setTimeout(function () { location.href = a.href; }, attesa + 2320);
          });
        });
        // Tornando indietro dalla cache del browser, la soglia deve essere di nuovo chiusa.
        addEventListener("pageshow", function () { document.body.classList.remove("entra", "velato"); document.documentElement.style.scrollBehavior = ""; });
      })();
    </script>
    )}

    <style is:global>
      :root {
        --antracite: #2b2e33;
        --antracite-2: #24272b;
        --antracite-3: #34383e;
        --rosso: #c8101a;
        --rosso-vivo: #e0262f;
        --chiaro: #eeeeec;
        --tenue: #a4a8ae;
        --linea: rgba(255, 255, 255, 0.12);
        --serif: "Times New Roman", Times, serif;
        --sans: Inter, system-ui, "Segoe UI", Arial, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--antracite); color: var(--chiaro);
        font-family: var(--sans); font-weight: 300; line-height: 1.6;
        -webkit-font-smoothing: antialiased; overflow-x: hidden;
      }
      img { display: block; max-width: 100%; }
      a { color: inherit; }
      h1, h2, h3 { font-family: var(--serif); font-weight: 400; margin: 0; }

      .etichetta, .occhiello {
        font-size: .75rem; letter-spacing: .28em; text-transform: uppercase;
        color: var(--rosso-vivo); font-weight: 500; margin: 0 0 1.2rem;
      }
      .occhiello { display: flex; align-items: center; gap: .9rem; }
      .filo { width: 2.6rem; height: 1px; background: var(--rosso-vivo); display: inline-block; }

      /* Il selettore di lingua, in alto a destra (come .lingue in global.css). */
      .lingue { display: inline-flex; border: 1px solid rgba(255, 255, 255, .22); border-radius: 2px; overflow: hidden; }
      .lingue a { font-size: .66rem; letter-spacing: .16em; font-weight: 600; text-decoration: none; line-height: 1; color: var(--tenue); padding: .5rem .62rem; transition: color .2s, background .2s; }
      .lingue a + a { border-left: 1px solid rgba(255, 255, 255, .22); }
      .lingue a:hover { color: #fff; }
      .lingue a[aria-current="true"] { background: var(--rosso); color: #fff; }
      .lingue--soglia { position: absolute; top: clamp(1rem, 2.4vw, 1.8rem); right: clamp(1.25rem, 3vw, 2.4rem); z-index: 6; }

      /* ── la soglia ── */
      .soglia {
        position: relative; min-height: 100svh;
        display: grid; grid-template-columns: minmax(0, 30rem) minmax(0, 1fr); align-items: center;
        gap: clamp(2rem, 6vw, 6rem); padding: clamp(2rem, 6vw, 5rem) clamp(1.25rem, 7vw, 7rem);
        background:
          radial-gradient(ellipse 50% 70% at 74% 50%, rgba(200, 16, 26, .10), transparent 70%),
          linear-gradient(180deg, var(--antracite-2), var(--antracite));
        overflow: hidden;
      }
      .marchio { line-height: .95; margin-bottom: 1.8rem; }
      .marchio__studio {
        display: block; font-size: clamp(1.4rem, 2.6vw, 2.1rem); letter-spacing: .06em;
        color: var(--tenue); margin-bottom: .6rem;
      }
      .marchio__sigla { display: block; font-size: clamp(4.2rem, 11vw, 9.5rem); letter-spacing: .02em; color: #fff; }
      .marchio__sigla i { font-style: normal; color: var(--rosso-vivo); }
      .soglia__frase { max-width: 30rem; font-size: clamp(1rem, 1.3vw, 1.15rem); color: var(--tenue); margin: 0 0 2.6rem; }
      .soglia__indirizzo { margin: 2rem 0 0; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; color: var(--tenue); }

      .accedi {
        display: inline-flex; align-items: center; gap: 1.1rem;
        padding: 1.25rem 2.2rem 1.25rem 2.4rem; background: var(--rosso); color: #fff;
        text-decoration: none; font-weight: 500; font-size: 1.05rem; letter-spacing: .14em; text-transform: uppercase;
        border-radius: 2px; box-shadow: 0 18px 40px -18px rgba(200, 16, 26, .8);
        transition: background .25s, transform .25s, box-shadow .25s;
      }
      .accedi svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: currentColor; stroke-width: 1.8; transition: transform .25s; }
      .accedi:hover { background: var(--rosso-vivo); transform: translateY(-2px); box-shadow: 0 24px 50px -18px rgba(224, 38, 47, .9); }
      .accedi:hover svg { transform: translateX(5px); }
      .accedi:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
      .accedi--grande { font-size: clamp(1.05rem, 1.6vw, 1.3rem); padding: 1.5rem 2.8rem; }

      .soglia__porta { justify-self: center; width: 100%; max-width: calc(84svh * 520 / 554); }
      .cornice {
        position: relative; width: 100%; aspect-ratio: 520 / 554;
        animation: arriva 1.4s cubic-bezier(.2, .7, .2, 1) both .15s;
        /* I bordi sfumano nel fondo antracite: la porta emerge dal buio. */
        -webkit-mask-image: radial-gradient(ellipse 60% 66% at 50% 47%, #000 62%, rgba(0,0,0,.7) 80%, rgba(0,0,0,.25) 92%, transparent 100%);
        mask-image: radial-gradient(ellipse 60% 66% at 50% 47%, #000 62%, rgba(0,0,0,.7) 80%, rgba(0,0,0,.25) 92%, transparent 100%);
      }
      /* Un alone scuro attorno, perché la porta affiori dal buio del fondo. */
      .soglia__porta { position: relative; }
      .soglia__porta::before {
        content: ""; position: absolute; inset: -12% -18%; z-index: -1; pointer-events: none;
        background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(10, 11, 13, .55), transparent 70%);
      }
      /* Un invito: sul pulsante o sulla porta, l'anta si socchiude e filtra la luce. */
      body:not(.entra) .soglia__porta:hover .anta__corpo, body:not(.entra) .soglia:has(.accedi:hover) .anta__corpo { transform: rotateY(24deg); }
      body:not(.entra) .soglia__porta:hover .portone__luce::after, body:not(.entra) .soglia:has(.accedi:hover) .portone__luce::after { opacity: .35; }
      .soglia__porta { display: block; text-decoration: none; }
      .soglia__porta:focus-visible { outline: 2px solid #fff; outline-offset: 8px; }
      @keyframes arriva { from { opacity: 0; transform: translateY(30px) scale(.97); } to { opacity: 1; transform: none; } }
      .soglia__testo > * { animation: arriva 1s cubic-bezier(.2, .7, .2, 1) both; }
      .soglia__testo > :nth-child(2) { animation-delay: .1s; }
      .soglia__testo > :nth-child(3) { animation-delay: .25s; }
      .soglia__testo > :nth-child(4) { animation-delay: .4s; }
      .soglia__testo > :nth-child(5) { animation-delay: .55s; }


      /* ── sezioni ── */
      main > section { padding: clamp(5rem, 11vw, 9rem) clamp(1.25rem, 7vw, 7rem); }
      .intesta { margin-bottom: 3.5rem; }
      .intesta h2, .luogo h2 { font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; color: #fff; }

      .dedica { text-align: center; max-width: 60rem; margin: 0 auto; }
      .dedica blockquote { margin: 0 0 2.5rem; }
      .dedica blockquote p { font-family: var(--serif); font-style: italic; font-size: clamp(1.8rem, 4.2vw, 3.4rem); line-height: 1.2; color: #fff; margin: 0; }
      .dedica__nota { max-width: 38rem; margin: 0 auto; color: var(--tenue); }
      .dedica__nota strong { color: var(--chiaro); font-weight: 500; }
      .dedica__link { display: inline-block; margin-top: 2rem; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; text-decoration: none; color: var(--chiaro); border-bottom: 1px solid var(--rosso); padding-bottom: .3rem; }
      .dedica__link:hover { color: var(--rosso-vivo); }
      .dedica .etichetta { display: flex; justify-content: center; align-items: center; gap: 1rem; }
      .dedica .etichetta::before, .dedica .etichetta::after { content: ""; width: 2.5rem; height: 1px; background: var(--rosso-vivo); }

      .tratti {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
        border-top: 1px solid var(--linea); border-bottom: 1px solid var(--linea);
        background: var(--antracite-2); padding-block: 0 !important;
      }
      .tratto { padding: 3.2rem clamp(1rem, 3vw, 3rem); border-left: 1px solid var(--linea); }
      .tratto:first-child { border-left: 0; }
      .tratto__num { font-family: var(--serif); font-size: 1.1rem; color: var(--rosso-vivo); letter-spacing: .1em; }
      .tratto h3 { font-size: 1.55rem; color: #fff; margin: .8rem 0 .7rem; }
      .tratto p { margin: 0; color: var(--tenue); font-size: .95rem; }

      .aree__elenco { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linea); }
      .aree__elenco li { border-bottom: 1px solid var(--linea); }
      .aree__elenco a {
        display: grid; grid-template-columns: 4.5rem 1fr 2rem; align-items: center; gap: 1.5rem;
        padding: 2rem .5rem; text-decoration: none; position: relative; transition: padding .35s, background .35s;
      }
      .aree__elenco a::before { /* la barra rossa che entra da sinistra */
        content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--rosso);
        transform: scaleY(0); transition: transform .35s; transform-origin: bottom;
      }
      .aree__elenco a:hover { background: var(--antracite-3); padding-left: 1.6rem; }
      .aree__elenco a:hover::before { transform: scaleY(1); }
      .aree__num { font-family: var(--serif); font-size: 2.2rem; color: var(--rosso-vivo); }
      .aree__titolo { display: block; font-family: var(--serif); font-size: clamp(1.4rem, 2.4vw, 2rem); color: #fff; line-height: 1.2; }
      .aree__sintesi { display: block; color: var(--tenue); font-size: .95rem; margin-top: .4rem; max-width: 46rem; }
      .aree__elenco svg { width: 1.6rem; height: 1.6rem; fill: none; stroke: var(--rosso-vivo); stroke-width: 1.6; transition: transform .35s; }
      .aree__elenco a:hover svg { transform: translateX(6px); }

      .persone { background: var(--antracite-2); }
      .persone__insieme { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
      .persone__foto { margin: 0; position: relative; }
      .persone__foto::after { content: ""; position: absolute; inset: 1.4rem -1.4rem -1.4rem 1.4rem; border: 1px solid rgba(200, 16, 26, .6); z-index: -1; }
      .persone__foto img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 40%; filter: grayscale(.2); box-shadow: 0 30px 60px -30px rgba(0,0,0,.9); }
      .persone { position: relative; z-index: 0; }
      .persone__nomi { list-style: none; margin: 0; padding: 0; }
      .persone__nomi li { border-top: 1px solid var(--linea); }
      .persone__nomi li:last-child { border-bottom: 1px solid var(--linea); }
      .persone__nomi a { display: block; padding: 1.4rem 0; text-decoration: none; transition: padding .35s; }
      .persone__nomi a:hover { padding-left: 1rem; }
      .persone__nomi a:hover .persona__nome { color: var(--rosso-vivo); }
      .persone__tutti { font-size: .75rem; letter-spacing: .2em; text-transform: uppercase; color: var(--tenue); }
      .dedica__nome { font-family: var(--serif); font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1.1; color: #fff; margin: 0 0 1.4rem; }
      .persona__nome { display: block; font-family: var(--serif); font-size: 1.45rem; color: #fff; }
      .persona__ruolo { display: block; font-size: .78rem; letter-spacing: .2em; text-transform: uppercase; color: var(--rosso-vivo); margin-top: .3rem; }

      .luogo { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
      .luogo__foto img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
      .luogo h2 { margin-bottom: 2rem; }
      .luogo dl { margin: 0; }
      .luogo dl div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--linea); }
      .luogo dt { font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--tenue); padding-top: .2rem; }
      .luogo dd { margin: 0; }
      .luogo dd a { text-decoration: none; border-bottom: 1px solid var(--rosso); }
      .luogo dd a:hover { color: #fff; border-color: var(--rosso-vivo); }

      .ancora { text-align: center; background: radial-gradient(ellipse 50% 60% at 50% 60%, rgba(200, 16, 26, .14), transparent 70%); }
      .ancora h2 { font-size: clamp(2.2rem, 5vw, 4rem); color: #fff; margin-bottom: 2.5rem; font-style: italic; }

      .piede { border-top: 1px solid var(--linea); padding: 2rem clamp(1.25rem, 7vw, 7rem); font-size: .8rem; color: var(--tenue); text-align: center; }
      .piede p { margin: .3rem 0; }
      .piede a { text-decoration: none; }
      .piede a:hover { color: var(--rosso-vivo); }

      /* ── la comparsa allo scorrimento ── */
      .js .sale { opacity: 0; transform: translateY(28px); transition: opacity .9s cubic-bezier(.2, .7, .2, 1) var(--ritardo, 0ms), transform .9s cubic-bezier(.2, .7, .2, 1) var(--ritardo, 0ms); }
      .js .sale.visibile { opacity: 1; transform: none; }

      /* ── l'ingresso: si entra nella porta ── */
      /* L'anta si spalanca verso l'interno mentre si avanza nel vano, fino
         a riempire lo schermo di luce: lì comincia la pagina interna. */
      .soglia__porta { will-change: transform; }
      .varco { position: fixed; inset: 0; opacity: 0; pointer-events: none; z-index: 10; }
      body.entra .anta__corpo { transform: rotateY(84deg); transition: transform 1.25s cubic-bezier(.4, 0, .2, 1); }
      body.entra .portone__luce::after { opacity: 1; }
      body.entra .anta__fronte::after { opacity: .28; }
      body.entra .soglia__porta { animation: varca 2.3s linear both; }
      body.entra .soglia__testo { opacity: 0; transform: translateX(-2rem); transition: opacity .6s, transform .8s cubic-bezier(.4, 0, .2, 1); }
      body.entra .varco { animation: bagliore 2.3s linear both; }
      .velo { position: fixed; inset: 0; z-index: 11; background: var(--antracite-2); opacity: 0; pointer-events: none; transition: opacity .38s ease; }
      body.velato .velo { opacity: 1; }
      /* «La pagina continua»: una freccetta sottile in basso, che scende piano.
         Discreta (semitrasparente), sparisce appena si scorre o si entra. */
      .continua {
        position: fixed; left: 50%; bottom: 1.1rem; z-index: 5; width: 2.6rem; height: 2.6rem; margin-left: -1.3rem;
        display: grid; place-items: center; color: var(--chiaro); opacity: .5; text-decoration: none;
        transition: opacity .5s;
      }
      .continua:hover { opacity: .9; }
      .continua svg { width: 1.5rem; height: 1.5rem; fill: none; stroke: currentColor; stroke-width: 1.4; animation: scende 2.6s ease-in-out infinite; }
      @keyframes scende { 0%, 100% { transform: translateY(-3px); opacity: .35; } 50% { transform: translateY(4px); opacity: 1; } }
      body.scorsa .continua, body.entra .continua, body.velato .continua { opacity: 0; pointer-events: none; }
      /* Sul telefono in basso a destra: al centro cadrebbe fra pulsante e indirizzo. */
      @media (max-width: 760px) { .continua { left: auto; right: .6rem; margin-left: 0; bottom: .6rem; } }
      /* Un solo movimento: la porta scivola al centro (curva morbida) e,
         già mentre arriva, lo zoom comincia e cresce in modo esponenziale,
         che all'occhio è una velocità costante. Punti calcolati, tratti lineari.
         Dall'80% lo schermo è già coperto dalla luce (vedi `bagliore`): lì lo
         zoom si ferma, perché il browser disegna la porta alla scala più
         grande dell'animazione e oltre sarebbe lavoro che non si vede. */
      @keyframes varca {
          0% { transform: translate(calc(var(--dx) * 0.000), calc(var(--dy) * 0.000)) scale(1.000); }
          5% { transform: translate(calc(var(--dx) * 0.023), calc(var(--dy) * 0.023)) scale(1.000); }
         10% { transform: translate(calc(var(--dx) * 0.087), calc(var(--dy) * 0.087)) scale(1.000); }
         15% { transform: translate(calc(var(--dx) * 0.183), calc(var(--dy) * 0.183)) scale(1.002); }
         20% { transform: translate(calc(var(--dx) * 0.301), calc(var(--dy) * 0.301)) scale(1.012); }
         25% { transform: translate(calc(var(--dx) * 0.432), calc(var(--dy) * 0.432)) scale(1.034); }
         30% { transform: translate(calc(var(--dx) * 0.568), calc(var(--dy) * 0.568)) scale(1.069); }
         35% { transform: translate(calc(var(--dx) * 0.699), calc(var(--dy) * 0.699)) scale(1.118); }
         40% { transform: translate(calc(var(--dx) * 0.817), calc(var(--dy) * 0.817)) scale(1.184); }
         45% { transform: translate(calc(var(--dx) * 0.913), calc(var(--dy) * 0.913)) scale(1.270); }
         50% { transform: translate(calc(var(--dx) * 0.977), calc(var(--dy) * 0.977)) scale(1.378); }
         55% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(1.516); }
         60% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(1.689); }
         65% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(1.907); }
         70% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(2.181); }
         75% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(2.529); }
         80% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(2.972); }
         85% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(3.200); }
         90% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(3.200); }
         95% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(3.200); }
        100% { transform: translate(calc(var(--dx) * 1.000), calc(var(--dy) * 1.000)) scale(3.200); }
      }
      /* La luce sale e poi si scioglie nell'antracite delle pagine interne:
         nessun lampo bianco al cambio di pagina. */
      @keyframes bagliore {
        0%, 50% { opacity: 0; background: #fff4df; }
        78%     { opacity: 1; background: #fff4df; }
        100%    { opacity: 1; background: #24272b; }
      }
      /* Il passaggio alla pagina interna: dissolvenza incrociata del browser. */
      @view-transition { navigation: auto; }

      /* ── telefono ── */
      @media (max-width: 820px) {
        .soglia { grid-template-columns: 1fr; padding-top: 3rem; padding-bottom: 6rem; text-align: left; }
        .soglia__porta { order: -1; }
        .soglia__porta { max-width: calc(46svh * 520 / 554); }
        .tratti, .persone__insieme, .luogo { grid-template-columns: 1fr; }
        .tratto { border-left: 0; border-top: 1px solid var(--linea); }
        .tratto:first-child { border-top: 0; }
        .aree__elenco a { grid-template-columns: 2.8rem 1fr 1.4rem; gap: 1rem; }
        .aree__num { font-size: 1.6rem; }
        .luogo dl div { grid-template-columns: 1fr; gap: .2rem; }
      }
      /* Telefono: sezioni più strette, i tratti in un carosello, le aree
         senza la sintesi (la si legge nella pagina dell'area). */
      @media (max-width: 760px) {
        html, body { overflow-x: clip; }
        main > section { padding: 3.4rem 1.25rem; }
        .intesta { margin-bottom: 1.8rem; }
        .dedica blockquote p, .dedica__nome { font-size: 2rem; }
        .tratti {
          display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
          padding: 0 !important;
        }
        .tratti::-webkit-scrollbar { display: none; }
        .tratto { flex: 0 0 80%; scroll-snap-align: start; padding: 2rem 1.4rem; border-top: 0 !important; border-left: 1px solid var(--linea) !important; }
        .tratto:first-child { border-left: 0 !important; }
        .tratto h3 { font-size: 1.3rem; }
        .aree__elenco a { padding: 1.2rem .2rem; }
        .aree__sintesi { display: none; }
        .aree__titolo { font-size: 1.25rem; }
        .persone__foto::after { inset: .7rem -.5rem -.5rem .7rem; }
        .persone__nomi a { padding: 1rem 0; }
        .persona__nome { font-size: 1.25rem; }
        .luogo dl div { padding: .6rem 0; }
        .ancora h2 { font-size: 2.2rem; margin-bottom: 1.8rem; }
        .accedi--grande { width: 100%; justify-content: center; }
        .piede { font-size: .72rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation: none !important; transition: none !important; }
        .js .sale { opacity: 1; transform: none; }
      }
    </style>
  </body>
</html>
