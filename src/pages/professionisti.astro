---
/**
 * «I professionisti», disegnata a mano: le persone dello studio, una per una,
 * con il ritratto, il profilo, il curriculum in PDF, l'albo, le lingue, i
 * contatti e le materie. Testi e foto si modificano dall'editor (vedi
 * src/lib/contenuti.ts); i valori di partenza stanno in src/dati/contenuti.mjs.
 */
export const prerender = false;

import Base from "../layouts/Base.astro";
import ContenutoEditor from "../components/ContenutoEditor.astro";
import { contenutoDi, marcatori, ancoraPersona } from "../lib/contenuti";
import { testi, traduttore } from "../lib/lingua";

const PREDEFINITO = testi(Astro).professionisti;
const L = traduttore(Astro);

const { c, componi } = await contenutoDi(Astro, "/professionisti", PREDEFINITO);
const { t, r, f, l, v } = marcatori(componi);
const E = c.etichetteDati;
---

<Base titolo="I professionisti" descrizione="I professionisti dello Studio Legale G.D.D. a Roma: profilo, curriculum, materie seguite e iscrizione all'albo." componi={componi}>
  <div class="pag">
    <header class="pag-apertura">
      <p class="pag-occhio" data-anima="sali" {...t("occhio")}>{c.occhio}</p>
      <h1 data-anima="sali" {...r("titolo")} set:html={c.titolo} />
      <p class="pag-lead" data-anima="sali" {...t("lead")}>{c.lead}</p>
    </header>

    <section class="pag-sezione persone" {...l("elenco")}>
      {c.elenco.map((p, i) => {
        const P = `elenco.${i}`;
        return (
          <article class="persona" id={ancoraPersona(p.nome)} {...v(i)}>
            <figure class="persona__ritratto incorniciata">
              <img src={p.foto} alt={`${L("Ritratto", "Portrait")}: ${p.nome}`} loading="lazy" width="1000" height="1250" {...f(`${P}.foto`)} />
            </figure>
            <div class="persona__testo">
              <span class="persona__num">{String(i + 1).padStart(2, "0")}</span>
              <p class="pag-etichetta" {...t(`${P}.ruolo`)}>{p.ruolo}</p>
              <h2 {...t(`${P}.nome`)}>{p.nome}</h2>
              <div class="persona__dettagli" data-riassumi={L("Leggi il profilo", "Read the profile")}>
                <div class="persona__bio" {...r(`${P}.bio`)} set:html={p.bio} />
                {/* Il curriculum è un PDF (public/cv/) che si apre in un'altra scheda. */}
                {p.cv && (
                  <p class="persona__cv-link">
                    <a href={p.cv} target="_blank" rel="noopener" type="application/pdf">{E.curriculum} (PDF)<span aria-hidden="true"> ↗</span></a>
                  </p>
                )}
                <dl class="persona__dati">
                  <div><dt>{E.albo}</dt><dd {...t(`${P}.albo`)}>{p.albo}</dd></div>
                  <div><dt>{E.lingue}</dt><dd {...t(`${P}.lingue`)}>{p.lingue}</dd></div>
                  {(p.contatti || componi) && (
                    <div><dt>{E.contatti}</dt><dd {...r(`${P}.contatti`)} set:html={p.contatti} /></div>
                  )}
                </dl>
                {(p.materie?.length > 0 || componi) && (
                  <>
                    <p class="pag-etichetta persona__materie-titolo">{E.materie}</p>
                    <ul class="pastiglie" {...l(`${P}.materie`)}>
                      {(p.materie ?? []).map((m, k) => <li {...v(k)} {...t(`${P}.materie.${k}`)}>{m}</li>)}
                    </ul>
                  </>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </section>
  </div>
  <ContenutoEditor c={c} componi={componi} />
</Base>

<style>
  /* Le persone: il ritratto resta fermo mentre il testo scorre. */
  .persona { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2.5rem, 7vw, 6rem); align-items: start; scroll-margin-top: 6rem; }
  .persona + .persona { margin-top: clamp(5rem, 10vw, 8rem); padding-top: clamp(5rem, 10vw, 8rem); border-top: 1px solid var(--linea); }
  .persona:nth-child(even of .persona) { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .persona:nth-child(even of .persona) .persona__ritratto { order: 2; }
  .persona__ritratto img { aspect-ratio: 4 / 5; object-fit: cover; filter: grayscale(.25) contrast(1.04); transition: filter .8s; }
  .persona:hover .persona__ritratto img { filter: none; }
  .persona__num { display: block; font-family: var(--serif); font-size: clamp(3rem, 6vw, 5rem); line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--accento-viva); margin-bottom: 1.2rem; }
  .persona h2 { font-size: clamp(2rem, 3.6vw, 2.9rem); margin: 0 0 1.8rem; }
  .persona__bio :global(p) { color: var(--inchiostro-2); font-size: 1.05rem; line-height: 1.8; }
  .persona__cv-link { margin: 2rem 0 0; }
  .persona__cv-link a {
    display: inline-block; padding: .85rem 1.4rem; border: 1px solid var(--accento); text-decoration: none;
    font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: var(--inchiostro); transition: background .3s, color .3s;
  }
  .persona__cv-link a:hover { background: var(--accento); color: #fff; }
  .persona__dati { margin: 2.2rem 0; }
  .persona__dati div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--linea); }
  .persona__dati div:last-child { border-bottom: 1px solid var(--linea); }
  .persona__dati dt { font-size: .7rem; letter-spacing: .22em; text-transform: uppercase; color: var(--tenue); padding-top: .2rem; }
  .persona__dati dd { margin: 0; font-size: .95rem; color: var(--inchiostro-2); }
  .persona__dati a { color: var(--inchiostro); text-decoration: none; border-bottom: 1px solid var(--accento); }
  .persona__dati a:hover { color: var(--accento-viva); }
  .persona__materie-titolo { margin-top: 1.6rem; }

  @media (max-width: 820px) {
    .persona { grid-template-columns: 1fr; }
    .persona__ritratto { max-width: 22rem; }
    .persona:nth-child(even of .persona) { grid-template-columns: 1fr; }
    .persona:nth-child(even of .persona) .persona__ritratto { order: 0; }
  }
  /* Sul telefono: foto piccola accanto al nome, il profilo sotto (e
     riassunto, con «Leggi il profilo»). */
  @media (max-width: 760px) {
    .persona, .persona:nth-child(even of .persona) {
      grid-template-columns: 7.5rem 1fr; column-gap: 1.2rem; row-gap: .15rem; align-items: end;
    }
    .persona + .persona { margin-top: 3.2rem; padding-top: 3.2rem; }
    .persona .persona__ritratto, .persona:nth-child(even of .persona) .persona__ritratto { grid-column: 1; grid-row: 1 / span 3; order: 0; max-width: none; }
    .persona__testo { display: contents; }
    .persona__num { grid-column: 2; font-size: 2.2rem; margin: 0; }
    .persona__testo > .pag-etichetta { grid-column: 2; margin: 0; font-size: .62rem; }
    .persona h2 { grid-column: 2; font-size: 1.45rem; margin: 0; }
    .persona__dettagli { grid-column: 1 / -1; margin-top: 1.4rem; }
    .persona__dati { margin: 1.4rem 0; }
    .persona__dati div { grid-template-columns: 5.2rem minmax(0, 1fr); }
    .persona__dati dd { overflow-wrap: anywhere; }
  }
</style>
