---
/**
 * «Aree di attività», disegnata a mano: le materie come schede numerate, con
 * le prime voci di ciascuna. Le aree sono le sottopagine di /aree: si
 * aggiungono, si tolgono e si riordinano dalla mappa dell'editor, e i loro
 * testi si scrivono nella pagina di ciascuna. Qui si modificano solo
 * l'apertura e la scritta «Approfondisci».
 */
export const prerender = false;

import Base from "../../layouts/Base.astro";
import ContenutoEditor from "../../components/ContenutoEditor.astro";
import { contenutoDi, elencoAree, marcatori } from "../../lib/contenuti";
import { testi } from "../../lib/lingua";

const { areeIndice, area: areaPredefinita } = testi(Astro);

const { c, componi } = await contenutoDi(Astro, "/aree", areeIndice);
const { t, r } = marcatori(componi);
const aree = await elencoAree(Astro, areaPredefinita);
---

<Base titolo="Aree di attività" descrizione="Le materie di cui si occupa lo Studio Legale G.D.D.: diritto penale e processuale penale, diritto civile e d'impresa, famiglia e minori, responsabilità e risarcimento del danno." componi={componi}>
  <div class="pag">
    <header class="pag-apertura">
      <p class="pag-occhio" data-anima="sali" {...t("occhio")}>{c.occhio}</p>
      <h1 data-anima="sali" {...r("titolo")} set:html={c.titolo} />
      <p class="pag-lead" data-anima="sali" {...t("lead")}>{c.lead}</p>
    </header>

    <section class="schede">
      {aree.map((a, i) => (
        <a class="scheda-area" href={a.href}>
          <span class="scheda-area__num">{String(i + 1).padStart(2, "0")}</span>
          <h2>{a.titolo}</h2>
          <p class="scheda-area__sintesi">{a.sintesi}</p>
          <ul>{(a.materie ?? []).slice(0, 4).map((m) => <li>{m}</li>)}</ul>
          <span class="scheda-area__vai">{c.vai} <i>→</i></span>
        </a>
      ))}
    </section>
  </div>
  <ContenutoEditor c={c} componi={componi} />
</Base>

<style>
  .schede { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--linea); border: 1px solid var(--linea); margin-bottom: clamp(4rem, 9vw, 7rem); }
  .scheda-area {
    position: relative; display: flex; flex-direction: column; gap: 1rem; text-decoration: none; color: inherit;
    padding: clamp(2rem, 4vw, 3.4rem); background: var(--carta); overflow: hidden;
    transition: background .5s;
  }
  .scheda-area::after {
    content: ""; position: absolute; right: -20%; top: -40%; width: 70%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(200, 16, 26, .16), transparent 70%); opacity: 0; transition: opacity .6s;
  }
  .scheda-area:hover { background: #30343a; color: inherit; }
  .scheda-area:hover::after { opacity: 1; }
  .scheda-area__num { font-family: var(--serif); font-size: 3.6rem; line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--accento-viva); }
  .scheda-area h2 { font-size: clamp(1.7rem, 2.8vw, 2.3rem); margin: .4rem 0 0; }
  .scheda-area__sintesi { color: var(--inchiostro-2); margin: 0; }
  .scheda-area ul { list-style: none; margin: .4rem 0 0; padding: 0; }
  .scheda-area li { font-size: .9rem; color: var(--tenue); padding: .45rem 0 .45rem 1.3rem; border-top: 1px solid var(--linea); position: relative; }
  .scheda-area li::before { content: "—"; position: absolute; left: 0; color: var(--accento-viva); }
  .scheda-area__vai { margin-top: auto; padding-top: 1.2rem; font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: #fff; }
  .scheda-area__vai i { display: inline-block; font-style: normal; color: var(--accento-viva); transition: transform .4s; }
  .scheda-area:hover .scheda-area__vai i { transform: translateX(8px); }
  @media (max-width: 820px) { .schede { grid-template-columns: 1fr; } }
  /* Telefono: schede corte, senza l'elenco delle voci. */
  @media (max-width: 760px) {
    .scheda-area { padding: 1.6rem 1.3rem; gap: .6rem; }
    .scheda-area__num { font-size: 2.4rem; }
    .scheda-area h2 { font-size: 1.45rem; }
    .scheda-area__sintesi { font-size: .95rem; }
    .scheda-area ul { display: none; }
    .scheda-area__vai { padding-top: .4rem; }
    .schede { margin-bottom: 3rem; }
  }
</style>
