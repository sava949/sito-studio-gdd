---
/**
 * La pagina in onore del Dott. Tommaso Novelli, a cui lo studio è dedicato.
 * Disegnata a mano; testi e foto si modificano dall'editor
 * (src/lib/contenuti.ts, valori di partenza in src/dati/contenuti.mjs).
 * La biografia completa va chiesta alla famiglia prima di aggiungerla.
 */
export const prerender = false;

import Base from "../layouts/Base.astro";
import ContenutoEditor from "../components/ContenutoEditor.astro";
import { contenutoDi, marcatori } from "../lib/contenuti";
import { testi, traduttore } from "../lib/lingua";

const PREDEFINITO = testi(Astro).novelli;
const L = traduttore(Astro);

const { c, componi } = await contenutoDi(Astro, "/tommaso-novelli", PREDEFINITO);
const { t, f, l, v } = marcatori(componi);
const ROMANI = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"];
---

<Base
  titolo={`${c.nome1} ${c.nome2}`}
  descrizione={`Lo Studio Legale G.D.D. è dedicato alla memoria del ${c.nome1} ${c.nome2}, ${c.carica1} ${c.carica2}.`}
  immagineSocial={c.foto}
  componi={componi}
  senzaInvito
>
  <article class="novelli">
    <!-- ── l'apertura ── -->
    <header class="novelli__apertura">
      <div class="novelli__testo">
        <p class="occhio" data-anima="sali"><span class="filo"></span><span {...t("occhio")}>{c.occhio}</span></p>
        <h1 data-anima="sali"><span {...t("nome1")}>{c.nome1}</span><br /><span {...t("nome2")}>{c.nome2}</span></h1>
        <p class="novelli__carica" data-anima="sali"><span {...t("carica1")}>{c.carica1}</span><br /><span {...t("carica2")}>{c.carica2}</span></p>
      </div>
      <figure class="novelli__toga">
        <img src={c.foto} alt={L("Ritratto del Dott. Tommaso Novelli", "Portrait of Dott. Tommaso Novelli")} width="900" height="1200" {...f("foto")} />
      </figure>
    </header>

    <!-- ── la dedica ── -->
    <section class="novelli__dedica">
      <blockquote data-anima="sali">
        <p {...t("citazione")}>{c.citazione}</p>
        <footer {...t("autore")}>{c.autore}</footer>
      </blockquote>
    </section>

    <!-- ── il ricordo ── -->
    <section class="novelli__corpo" {...l("colonne")}>
      {c.colonne.map((col, i) => (
        <div class="colonna" data-anima="sali" {...v(i)}>
          <p class="occhio" {...t(`colonne.${i}.etichetta`)}>{col.etichetta}</p>
          <p {...t(`colonne.${i}.testo`)}>{col.testo}</p>
        </div>
      ))}
    </section>

    <!-- ── la cronologia ── -->
    <section class="cronologia">
      <div class="cronologia__capo" data-anima="sali">
        <p class="occhio" {...t("cronologia.occhio")}>{c.cronologia.occhio}</p>
        <h2 {...t("cronologia.titolo")}>{c.cronologia.titolo}</h2>
      </div>
      <ol class="cronologia__tappe" {...l("cronologia.tappe")}>
        {c.cronologia.tappe.map((x, i) => (
          <li class="tappa" {...v(i)}>
            <span class="tappa__anno" {...t(`cronologia.tappe.${i}.anno`)}>{x.anno}</span>
            <p class="tappa__testo" {...t(`cronologia.tappe.${i}.testo`)}>{x.testo}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ── i valori ── -->
    <section class="novelli__valori carosello-tel" {...l("valori")}>
      {c.valori.map((val, i) => (
        <div class="valore" data-anima="sali" {...v(i)}>
          <span>{ROMANI[i] ?? i + 1}</span>
          <h2 {...t(`valori.${i}.titolo`)}>{val.titolo}</h2>
          <p {...t(`valori.${i}.testo`)}>{val.testo}</p>
        </div>
      ))}
    </section>

    <!-- ── oltre ── -->
    <section class="novelli__oltre" data-anima="sali">
      <p class="occhio" {...t("oltre.occhio")}>{c.oltre.occhio}</p>
      <h2 {...t("oltre.titolo")}>{c.oltre.titolo}</h2>
      <div class="novelli__azioni">
        <a class="bottone" href="/studio" {...t("oltre.bottone")}>{c.oltre.bottone}</a>
        <a class="novelli__link" href="/aree" {...t("oltre.link")}>{c.oltre.link}</a>
      </div>
    </section>
  </article>
  <ContenutoEditor c={c} componi={componi} />
</Base>

<style>
  .novelli { --largo-n: 72rem; padding-inline: clamp(1.25rem, 6vw, 6rem); }
  .novelli > * { max-width: var(--largo-n); margin-inline: auto; }
  .occhio {
    display: flex; align-items: center; gap: .9rem; margin: 0 0 1.2rem;
    font-size: .74rem; letter-spacing: .28em; text-transform: uppercase; font-weight: 500; color: var(--accento-viva);
  }
  .filo { width: 2.6rem; height: 1px; background: var(--accento-viva); display: inline-block; }

  /* L'apertura: il nome grande a sinistra, il ritratto a destra che sfuma nel buio. */
  .novelli__apertura {
    display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: clamp(2rem, 6vw, 6rem);
    min-height: min(78svh, 46rem); padding-block: clamp(3rem, 8vw, 6rem) 2rem;
  }
  .novelli h1 { font-size: clamp(3rem, 7.5vw, 6.4rem); line-height: .98; margin: 0 0 1.6rem; font-weight: 400; }
  .novelli__carica { font-family: var(--serif); font-style: italic; font-size: clamp(1.2rem, 2.2vw, 1.7rem); line-height: 1.35; color: var(--tenue); margin: 0; }
  .novelli__toga { margin: 0; justify-self: center; width: min(26rem, 100%); }
  .novelli__toga img {
    width: 100%; aspect-ratio: 3 / 4; object-fit: cover; filter: brightness(.88);
    -webkit-mask-image: radial-gradient(ellipse 60% 64% at 50% 46%, #000 55%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 64% at 50% 46%, #000 55%, transparent 100%);
  }

  /* La dedica, al centro, grande. */
  .novelli__dedica { padding-block: clamp(4rem, 9vw, 7rem); text-align: center; border-block: 1px solid var(--linea); }
  .novelli__dedica blockquote { margin: 0 auto; max-width: 52rem; }
  .novelli__dedica p { font-family: var(--serif); font-style: italic; font-size: clamp(1.8rem, 4vw, 3.1rem); line-height: 1.2; color: #fff; margin: 0 0 1.6rem; }
  .novelli__dedica footer { font-size: .74rem; letter-spacing: .28em; text-transform: uppercase; color: var(--accento-viva); }

  .novelli__corpo { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); padding-block: clamp(4rem, 9vw, 7rem); }
  .novelli__corpo p:not(.occhio) { font-size: 1.12rem; line-height: 1.8; color: var(--inchiostro-2); margin: 0; }

  /* La cronologia: gli anni a sinistra in Times rosso, un filo verticale che
     unisce le tappe, il testo a destra. */
  .cronologia {
    display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(4rem, 9vw, 7rem); border-top: 1px solid var(--linea);
    /* Il titolo sta fermo, a metà altezza delle tappe. */
    align-items: center;
  }
  .cronologia__capo h2 { font-size: clamp(2rem, 3.6vw, 2.9rem); line-height: 1.1; }
  .cronologia__tappe { list-style: none; margin: 0; padding: 0; position: relative; }
  .cronologia__tappe::before {
    content: ""; position: absolute; left: 7.4rem; top: .9rem; bottom: .9rem; width: 1px;
    background: linear-gradient(var(--accento), var(--linea) 85%);
  }
  .tappa { display: grid; grid-template-columns: 7.4rem 1fr; gap: 2.2rem; padding: 1.1rem 0; position: relative; }
  .tappa::after {
    content: ""; position: absolute; left: calc(7.4rem - 4px); top: 1.55rem; width: 9px; height: 9px;
    border-radius: 50%; background: var(--carta); border: 1px solid var(--accento-viva);
  }
  .tappa__anno { font-family: var(--serif); font-size: 1.7rem; line-height: 1.1; color: var(--accento-viva); text-align: right; padding-right: 1.2rem; }
  .tappa__testo { margin: 0; color: var(--inchiostro-2); font-size: 1.04rem; line-height: 1.75; padding-top: .2rem; }

  .novelli__valori {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    border-block: 1px solid var(--linea); background: rgba(0, 0, 0, .12);
  }
  .valore { padding: clamp(2rem, 4vw, 3.2rem) clamp(1.2rem, 3vw, 2.6rem); border-left: 1px solid var(--linea); }
  .valore:first-child { border-left: 0; }
  .valore span { font-family: var(--serif); color: var(--accento-viva); letter-spacing: .1em; }
  .valore h2 { font-size: 1.7rem; margin: .7rem 0 .6rem; }
  .valore p { margin: 0; color: var(--tenue); font-size: .98rem; }

  .novelli__oltre { padding-block: clamp(4rem, 9vw, 7rem); text-align: center; }
  .novelli__oltre .occhio { justify-content: center; }
  .novelli__oltre h2 { font-size: clamp(2rem, 4vw, 3rem); font-style: italic; margin-bottom: 2.2rem; }
  .novelli__azioni { display: flex; gap: 2rem; justify-content: center; align-items: center; flex-wrap: wrap; }
  .novelli__azioni .bottone { padding: 1.2rem 2.4rem; }
  .novelli__link { text-decoration: none; color: var(--inchiostro); letter-spacing: .14em; text-transform: uppercase; font-size: .8rem; }
  .novelli__link:hover { color: var(--accento-viva); }

  /* Uno dopo l'altro, con calma. */
  .novelli__valori .valore:nth-child(2) { transition-delay: .12s; }
  .novelli__valori .valore:nth-child(3) { transition-delay: .24s; }

  /* Telefono: apertura più bassa, valori in un carosello. */
  @media (max-width: 760px) {
    .cronologia { grid-template-columns: 1fr; gap: 1.4rem; padding-block: 2.8rem; }
    .cronologia__capo h2 { font-size: 1.8rem; }
    .cronologia__tappe::before { left: 4.6rem; }
    .tappa { grid-template-columns: 4.6rem 1fr; gap: 1.2rem; padding: .8rem 0; }
    .tappa::after { left: calc(4.6rem - 4px); top: 1.2rem; }
    .tappa__anno { font-size: 1.15rem; padding-right: .8rem; }
    .tappa__testo { font-size: .95rem; line-height: 1.65; }
    .novelli__apertura { min-height: 0; padding-block: 2rem 1rem; gap: 1.6rem; }
    .novelli h1 { font-size: 2.8rem; margin-bottom: 1rem; }
    .novelli__carica { font-size: 1.15rem; }
    .novelli__toga { width: min(14rem, 60vw); }
    .novelli__dedica { padding-block: 2.8rem; }
    .novelli__dedica p { font-size: 1.7rem; }
    .novelli__corpo { padding-block: 2.8rem; gap: 2rem; }
    .novelli__corpo p:not(.occhio) { font-size: 1rem; line-height: 1.7; }
    .valore { border-top: 0 !important; border-left: 1px solid var(--linea) !important; padding: 1.8rem 1.4rem; }
    .valore:first-child { border-left: 0 !important; }
    .novelli__oltre { padding-block: 3rem; }
    .novelli__oltre h2 { font-size: 1.8rem; }
  }
  @media (max-width: 820px) {
    .novelli__apertura, .novelli__corpo, .novelli__valori { grid-template-columns: 1fr; }
    .novelli__toga { order: -1; width: min(18rem, 70vw); }
    .valore { border-left: 0; border-top: 1px solid var(--linea); }
    .valore:first-child { border-top: 0; }
  }
</style>
