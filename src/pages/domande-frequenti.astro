---
/**
 * «Domande frequenti», disegnata a mano: le domande che ricorrono, divise per
 * materia, con la risposta che si apre al clic (details/summary: funziona
 * anche senza JavaScript). Risposte generali; nessuna indicazione sui
 * compensi (questionario, sezione 5.3). Domande, risposte e gruppi si
 * modificano dall'editor (src/lib/contenuti.ts): in composizione le risposte
 * restano aperte, per poterle scrivere.
 */
export const prerender = false;

import Base from "../layouts/Base.astro";
import ContenutoEditor from "../components/ContenutoEditor.astro";
import { contenutoDi, marcatori } from "../lib/contenuti";
import { testi, traduttore } from "../lib/lingua";

const PREDEFINITO = testi(Astro).domande;
const L = traduttore(Astro);

const { c, componi } = await contenutoDi(Astro, "/domande-frequenti", PREDEFINITO);
const { t, r, l, v } = marcatori(componi);
---

<Base titolo="Domande frequenti" descrizione="Le domande più frequenti rivolte allo Studio Legale G.D.D.: indagini e processo penale, separazione e divorzio, risarcimento del danno, il primo colloquio." componi={componi}>
  <div class="pag">
    <header class="pag-apertura">
      <p class="pag-occhio" data-anima="sali" {...t("occhio")}>{c.occhio}</p>
      <h1 data-anima="sali" {...r("titolo")} set:html={c.titolo} />
      <p class="pag-lead" data-anima="sali" {...t("lead")}>{c.lead}</p>
      <nav class="indice" aria-label={L("Argomenti", "Topics")} data-anima="sali">
        {c.gruppi.map((g, i) => <a href={`#${g.id || `gruppo-${i + 1}`}`}>{g.titolo}</a>)}
      </nav>
    </header>

    <div {...l("gruppi")}>
      {c.gruppi.map((g, i) => (
        <section class="gruppo" id={g.id || `gruppo-${i + 1}`} {...v(i)}>
          <div class="gruppo__capo">
            <h2 {...t(`gruppi.${i}.titolo`)}>{g.titolo}</h2>
            {g.area && <a class="gruppo__area" href={g.area}>{c.linkArea}</a>}
          </div>
          <div class="gruppo__voci" {...l(`gruppi.${i}.voci`)}>
            {g.voci.map((x, k) => (
              <details class="voce" open={componi} {...v(k)}>
                <summary><span {...t(`gruppi.${i}.voci.${k}.d`)}>{x.d}</span><i aria-hidden="true"></i></summary>
                <div class="voce__risposta" {...r(`gruppi.${i}.voci.${k}.r`)} set:html={x.r} />
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="avvertenza" {...r("avvertenza")} set:html={c.avvertenza} />
  </div>
  <ContenutoEditor c={c} componi={componi} />
</Base>

<style>
  .indice { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2.6rem; }
  .indice a {
    font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; text-decoration: none; color: var(--inchiostro);
    padding: .7rem 1.1rem; border: 1px solid var(--linea-forte); border-radius: 999px; transition: border-color .3s, color .3s;
  }
  .indice a:hover { border-color: var(--accento); color: #fff; }

  .gruppo { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(2rem, 6vw, 5rem); padding-block: clamp(3.5rem, 8vw, 6rem); border-top: 1px solid var(--linea); scroll-margin-top: 6rem; }
  .gruppo__capo h2 { font-size: clamp(1.9rem, 3.4vw, 2.7rem); margin-bottom: 1.2rem; }
  .gruppo__area { font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; text-decoration: none; color: var(--tenue); border-bottom: 1px solid var(--accento); padding-bottom: .2rem; }
  .gruppo__area:hover { color: var(--accento-viva); }

  /* Le domande: si aprono al clic, il segno + ruota in ×. */
  .voce { border-top: 1px solid var(--linea); }
  .voce:last-child { border-bottom: 1px solid var(--linea); }
  .voce summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; cursor: pointer; list-style: none;
    padding: 1.4rem 0; font-family: var(--serif); font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.35; color: #fff;
    transition: color .3s;
  }
  .voce summary::-webkit-details-marker { display: none; }
  .voce summary:hover { color: var(--accento-viva); }
  .voce summary i { position: relative; flex: 0 0 1rem; height: 1rem; }
  .voce summary i::before, .voce summary i::after {
    content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--accento-viva); transition: transform .35s;
  }
  .voce summary i::after { transform: rotate(90deg); }
  .voce[open] summary i::before { transform: rotate(45deg); }
  .voce[open] summary i::after { transform: rotate(135deg); }
  .voce__risposta { padding: 0 3rem 1.6rem 0; }
  .voce__risposta :global(p) { color: var(--inchiostro-2); font-size: 1.02rem; line-height: 1.8; margin: 0 0 1em; }
  .voce__risposta :global(p:last-child) { margin: 0; }
  .voce__risposta :global(a) { color: #fff; }
  .voce[open] .voce__risposta { animation: apri .45s ease; }
  @keyframes apri { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

  .avvertenza {
    margin: 0 auto clamp(3rem, 7vw, 5rem); max-width: 76rem; padding-top: 1.4rem;
    border-top: 1px solid var(--linea);
    font-family: var(--serif); font-style: italic; color: var(--tenue); font-size: .98rem; line-height: 1.7;
  }
  .avvertenza a { color: var(--inchiostro); }

  /* Telefono: l'indice scorre di lato, gruppi più stretti. */
  @media (max-width: 760px) {
    .indice { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-top: 1.6rem; }
    .indice::-webkit-scrollbar { display: none; }
    .indice a { flex: 0 0 auto; }
    .gruppo { padding-block: 2.4rem; }
    .gruppo__capo h2 { font-size: 1.7rem; margin-bottom: .6rem; }
    .voce summary { font-size: 1.08rem; padding: 1.1rem 0; }
    .voce__risposta :global(p) { font-size: .96rem; }
  }
  @media (max-width: 820px) {
    .gruppo { grid-template-columns: 1fr; gap: 1.4rem; }
    .voce__risposta { padding-right: 0; }
  }
</style>
