# Copia questo file in `.env` e riempi i valori. In produzione, le stesse
# chiavi vanno fra le variabili d'ambiente di Render.

# Indirizzo pubblico del sito. In locale lascia pure quello di sviluppo;
# in produzione mettici il dominio vero (da qui si ricavano i link canonici
# e l'host di cui fidarsi per i caricamenti di file).
SITE_URL=http://localhost:4321

# Postgres su Neon: la connection string del database di PRODUZIONE.
DATABASE_URL=

# Un SECONDO database Neon, solo per le prove automatiche. DEVE essere diverso
# da DATABASE_URL: la prova browser scrive, pubblica e cancella, e non deve
# mai toccare la produzione. Senza questo, `npm run prove:browser` si rifiuta
# di partire.
DATABASE_URL_PROVE=

# Segreto per firmare il cookie di sessione dell'editor. Diverso fra locale e
# produzione. Una stringa lunga e casuale.
ADMIN_SECRET=

# Cloudflare R2 per le immagini.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# L'indirizzo pubblico da cui si servono le immagini caricate (il dominio
# r2.dev del bucket, o un sottodominio tuo).
R2_PUBLIC_URL=
# Solo se il bucket ha una giurisdizione (su Cloudflare accanto al nome compare
# «EU»): allora `eu`. Senza, R2 risponde 403 AccessDenied anche col token giusto.
R2_JURISDICTION=

# Email del modulo di contatto — TUTTE FACOLTATIVE. Senza, i messaggi si
# salvano comunque nella casella dell'editor; con, arriva anche una notifica.
# Provider: Resend (https://resend.com). CONTACT_FROM dev'essere un mittente
# verificato; in prova va onboarding@resend.dev (consegna solo a te).
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
